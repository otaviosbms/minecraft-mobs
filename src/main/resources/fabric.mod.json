{
  "schemaVersion": 1,
  "id": "mobmod",
  "version": "${version}",
  "name": "Minecraft Mobs",
  "description": "Adds realistic animals (elephant, chimpanzee, meerkat) and adapts vanilla ones (camel) to the same rules: sexes, skin variants, regeneration and sleep.",
  "authors": [
    "Otavi"
  ],
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.otavi.mobmod.MobMod"
    ],
    "client": [
      "com.otavi.mobmod.client.MobModClient"
    ],
    "fabric-datagen": [
      "com.otavi.mobmod.client.datagen.MobModDataGenerator"
    ],
    "fabric-gametest": [
      "com.otavi.mobmod.gametest.MobGameTests"
    ]
  },
  "accessWidener": "mobmod.accesswidener",
  "mixins": [
    "mobmod.mixins.json"
  ],
  "depends": {
    "minecraft": "~26.3-",
    "fabricloader": ">=0.19.5",
    "fabric-api": "*"
  }
}
